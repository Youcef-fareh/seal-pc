{
  "manifest_version": 3,
  "name": "Seal Desktop Link Sender",
  "version": "1.0.0",
  "description": "Send the current YouTube video to Seal Desktop.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:43721/*"],
  "action": {
    "default_title": "Send to Seal Desktop",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
